# Copy this file to .env and fill in real values. Never commit .env.
# Secret key for session cookies. Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Email of the site owner. The account that signs up with this email becomes admin.
ADMIN_EMAIL=owner@example.com
# Set to "true" to seed clearly-labeled DEMO profiles for testing. Off by default.
DEMO_MODE=false
# Optional: override the SQLite database file location.
# DATABASE_PATH=/data/dating.db
